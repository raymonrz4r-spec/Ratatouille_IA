# ============================================================================
# RATATOUILLE AI - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ============================================================================

# --- 1. SUPABASE (Base de Datos PostgreSQL & Storage S3) ---
DATABASE_URL=postgresql://[USER]:[PASSWORD]@[HOST]:5432/postgres?sslmode=require
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_KEY=tu_supabase_anon_o_service_key_aqui
SUPABASE_STORAGE_BUCKET=recipe-images

# --- 2. INTELIGENCIA ARTIFICIAL (Groq Whisper / Llama & Gemini) ---
GROQ_API_KEY=gsk_tu_groq_api_key_aqui
GEMINI_API_KEY=tu_gemini_api_key_aqui

# --- 3. AUTENTICACIÓN GOOGLE OAUTH 2.0 ---
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
APP_SECRET=tu_app_secret_aleatorio

# --- 4. CONEXIÓN FRONTEND <-> BACKEND ---
VITE_API_URL=https://[tu-backend].onrender.com
FRONTEND_URL=https://ratatouille-ia.vercel.app
CORS_ORIGINS=https://ratatouille-ia.vercel.app,http://localhost:5173
